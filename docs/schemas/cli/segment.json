{
    "type": "object",
    "properties": {
        "sid": {
            "anyOf": [
                {
                    "title": "SR-MPLS label",
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1048575
                },
                {
                    "$comment": "20-bit MPLS label range (0-1048575).",
                    "title": "SR-MPLS label, quoted",
                    "type": "string",
                    "pattern": "^0*(?:[0-9]{1,6}|10(?:[0-3][0-9]{4}|4(?:[0-7][0-9]{3}|8(?:[0-4][0-9]{2}|5(?:[0-6][0-9]|7[0-5])))))$"
                },
                {
                    "title": "SRv6 SID, IPv6 only",
                    "type": "string",
                    "format": "ipv6"
                }
            ]
        },
        "localAddr": {
            "$ref": "#/$defs/ipAddr"
        },
        "remoteAddr": {
            "$ref": "#/$defs/ipAddr"
        },
        "sidStructure": {
            "type": "string",
            "pattern": "^[0-9]+,[0-9]+,[0-9]+,[0-9]+$",
            "description": "<locator-block>,<locator-node>,<function>,<argument>"
        },
        "localInterfaceId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "description": "Local interface ID for an SR-MPLS unnumbered or link-local adjacency NAI (RFC 8664 §4.3.1, types 5/6), or an SRv6 link-local adjacency NAI (RFC 9603 §4.3.1, type 6). Required together with remoteInterfaceId."
        },
        "remoteInterfaceId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "description": "Remote interface ID for an unnumbered or IPv6 link-local adjacency NAI. Required together with localInterfaceId."
        },
        "unnumbered": {
            "type": "boolean",
            "description": "Selects NAI type 5 (Unnumbered Adjacency with IPv4 Node IDs) instead of type 3 (IPv4 Adjacency) when localAddr/remoteAddr are IPv4. Requires localInterfaceId and remoteInterfaceId."
        }
    },
    "required": [
        "sid"
    ],
    "additionalProperties": false,
    "$defs": {
        "ipAddr": {
            "$comment": "anyOf, not oneOf: `format` is an annotation by default, so both branches would match and oneOf would always fail",
            "type": "string",
            "anyOf": [
                { "format": "ipv4" },
                { "format": "ipv6" }
            ]
        }
    }
}
